CARRIEROS_BASE_URL=http://localhost:3100
CARRIEROS_CLIENT_ID=pub_client_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CARRIEROS_CLIENT_SECRET=pub_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Hosted OAuth for ChatGPT/other remote MCP clients. The encryption key must
# be 32 random bytes, base64-encoded; never commit the real value.
MCP_PUBLIC_URL=https://your-mcp-host.example.com
MCP_OAUTH_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
